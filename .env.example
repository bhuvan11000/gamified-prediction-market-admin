# Supabase (same as main app)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Frontend (safe to expose)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Admin auth
ADMIN_EMAIL=your-admin-email@gmail.com
VITE_ADMIN_EMAIL=your-admin-email@gmail.com

# Main app URL (for proxying admin actions and triggers)
MAIN_APP_URL=https://<main-app>.netlify.app

# Frontend main app URL (links to main app)
VITE_MAIN_APP_URL=https://<main-app>.netlify.app

# Shared secret for cron trigger proxy requests
CRON_SECRET=...
